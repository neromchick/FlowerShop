# =================================================================
# ШАБЛОН НАСТРОЕК ДЛЯ ПРОДАКШЕН-СЕРВЕРА
# =================================================================
# Инструкция:
# 1. На сервере скопируйте этот файл в .env:
#    cp .env.example .env
# 2. Заполните реальными значениями (замените плейсхолдеры).
# 3. Файл .env добавлен в .gitignore и НИКОГДА не попадет в Git.
# =================================================================

# 1. База данных PostgreSQL
POSTGRES_DB=flowershop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Строка подключения для ASP.NET Core
# Для локального запуска: Host=localhost;Port=5432;Database=flowershop;Username=postgres;Password=your_postgres_password_here;
# Для Neon: Host=ep-broad-...-pooler.c-6.us-east-2.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=YOUR_SECRET_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=flowershop;Username=postgres;Password=your_postgres_password_here;"

# 2. JWT токены авторизации (ключ должен быть не короче 32 символов)
JWT_KEY=SuperSecretProductionKey_MustBeAtLeast32CharsLong!
JWT_ISSUER=FlowerShop
JWT_AUDIENCE=FlowerShopClient
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# 3. Сеть и порты для сайта
# Укажите публичный IP-адрес или домен вашего сервера (без слеша на конце):
CORS_ORIGIN=http://https://app-flowershop.netlify.app/

# Порт, на котором будет доступен сайт в браузере (80 - стандартный веб-порт HTTP):
FRONTEND_PORT=80
BACKEND_PORT=5000

# 4. Режим ASP.NET Core (Production отключает детальный вывод ошибок для безопасности)
ENVIRONMENT=Production
